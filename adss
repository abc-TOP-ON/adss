                st.Completed:Wait()
                task.wait(0.15)
            else
                break
            end
        end
        if scan_bar and scan_bar.Parent then
            scan_bar.BackgroundTransparency = 1
        end
    end)

    task.spawn(function()
        -- ===== هنا تحط كود السكربت الرئيسي مباشرة =====
        -- بدل ما يجيب من سيرفر خارجي، حط الكود هنا
        local script_source = [[
            print("✅ Script Loaded Successfully!")
            print("🎯 Welcome " .. game.Players.LocalPlayer.Name)
            
            -- ===== ضع كود السكربت حقك هنا =====
            -- مثال:
            -- game:GetService("StarterGui"):SetCore("SendNotification", {
            --     Title = "Loaded",
            --     Text = "Script is running!",
            --     Duration = 3
            -- })
            
            -- ===== أو حمل من سيرفر آخر (اختياري) =====
            -- local source = game:HttpGet("https://raw.githubusercontent.com/YourName/YourScript/main/script.lua")
            -- loadstring(source)()
        ]]
        
        local success, err = pcall(function()
            local chunk = loadstring(script_source)
            if chunk then
                chunk()
                return true
            else
                return false, "Failed to compile"
            end
        end)

        scan_active = false

        if success then
            show_notification("Success", "Script Loaded!", 3)

            if scan_bar and scan_bar.Parent then
                create_smooth_tween(scan_bar, {Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0.7}, 0.3)
                task.wait(0.2)
