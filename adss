                    end
                    if child:IsA("Frame") or child:IsA("TextButton") then
                        create_smooth_tween(child, {BackgroundTransparency = 1}, 0.35)
                    end
                    if child:IsA("UIStroke") then
                        create_smooth_tween(child, {Transparency = 1}, 0.35)
                    end
